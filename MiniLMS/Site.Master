
<%@ Master Language="C#" AutoEventWireup="true"
    CodeBehind="Site.master.cs"
    Inherits="MiniLMS.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> | MiniLMS</title>

    <style type="text/css">
        * { box-sizing: border-box; }

        body {
            margin: 0;
            font-family: 'Segoe UI', Arial, sans-serif;
            font-size: 14px;
            background: #f5f7fb;
            color: #183451;
        }

        .topbar {
            position: sticky;
            top: 0;
            z-index: 1000;
            min-height: 72px;
            background: #102e50;
            color: white;
            padding: 12px 34px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
        }

        .nav-left {
            display: flex;
            align-items: center;
            gap: 36px;
            min-width: 0;
        }

        .brand {
            color: white;
            font-size: 22px;
            font-weight: 800;
            text-decoration: none;
            white-space: nowrap;
        }

        .brand span { color: #61a9f5; }

        .nav {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .nav a {
            display: inline-flex;
            align-items: center;
            padding: 10px 15px;
            border-radius: 8px;
            text-decoration: none;
            color: #d6e4f2;
            font-size: 13px;
            font-weight: 600;
            white-space: nowrap;
        }

        .nav a:hover {
            background: #244a70;
            color: white;
        }

        .nav a.active {
            background: #28598e;
            color: white;
        }

        .nav-account {
            position: relative;
            flex-shrink: 0;
        }

        .nav-account summary {
            display: flex;
            align-items: center;
            gap: 11px;
            padding: 7px 10px;
            border-radius: 9px;
            list-style: none;
            cursor: pointer;
        }

        .nav-account summary:hover {
            background: #244a70;
        }

        .nav-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: #e5eef9;
            color: #174b7e;
            display: grid;
            place-items: center;
            overflow: hidden;
            font-weight: 800;
        }

        .nav-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .nav-user {
            display: flex;
            flex-direction: column;
            gap: 3px;
            max-width: 180px;
        }

        .nav-user strong {
            font-size: 12px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .nav-user small {
            font-size: 11px;
            color: #c6d8ed;
        }

        .nav-dropdown {
            position: absolute;
            right: 0;
            top: 100%;
            width: 235px;
            padding: 8px;
            margin-top: 10px;
            background: white;
            color: #183451;
            border: 1px solid #e1e9f2;
            border-radius: 12px;
            box-shadow: 0 16px 36px rgba(16,46,80,0.16);
            z-index: 1100;
        }

        .dropdown-caption {
            padding: 12px;
            margin-bottom: 5px;
            border-bottom: 1px solid #edf1f6;
        }

        .dropdown-caption strong {
            display: block;
            font-size: 13px;
        }

        .dropdown-caption small {
            display: block;
            color: #72849a;
            margin-top: 4px;
        }

        .dropdown-link,
        .logout-button {
            display: block;
            width: 100%;
            padding: 11px 12px;
            background: transparent;
            border: none;
            border-radius: 7px;
            color: #2b435d;
            text-align: left;
            font-family: 'Segoe UI', Arial, sans-serif;
            font-size: 13px;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
        }

        .dropdown-link:hover {
            background: #f0f5fc;
        }

        .logout-button { color: #b43f46; }

        .logout-button:hover {
            background: #fff0f1;
        }

        .main {
            min-height: calc(100vh - 72px);
            width: 100%;
            padding: 24px 32px 48px;
        }

        .main-content {
            width: 100%;
            max-width: none;
            margin: 0;
        }

        @media screen and (max-width: 760px) {
            .topbar {
                padding: 12px 15px;
                gap: 8px;
            }

            .nav-left { gap: 13px; }
            .brand { font-size: 17px; }
            .nav { gap: 0; }

            .nav a {
                padding: 9px 7px;
                font-size: 11px;
            }

            .nav-user { display: none; }

            .nav-account summary { padding: 5px; }

            .nav-avatar {
                width: 32px;
                height: 32px;
            }

            .main { padding: 25px 16px 48px; }
        }

        @media screen and (max-width: 420px) {
            .brand { font-size: 15px; }
            .nav-left { gap: 7px; }

            .nav a {
                padding: 8px 5px;
                font-size: 10px;
            }
        }
    </style>

    <asp:ContentPlaceHolder
        ID="HeadContent"
        runat="server" />
</head>

<body>
    <form id="form1"
          runat="server"
          enctype="multipart/form-data">

        <asp:ScriptManager
            ID="ScriptManager1"
            runat="server" />

        <header class="topbar">
            <div class="nav-left">
                <a class="brand"
                   href="<%= ResolveUrl("~/") %>">
                    Mini<span>LMS</span>
                </a>

                <nav class="nav"
                     aria-label="Main navigation">

                    <asp:HyperLink
                        ID="lnkDashboard"
                        runat="server"
                        Text="Dashboard" />

                    <asp:HyperLink
                        ID="lnkUsers"
                        runat="server"
                        Text="Users"
                        Visible="false" />

                    <asp:HyperLink
                        ID="lnkCourses"
                        runat="server"
                        Text="Courses" />

                    <!-- Admin-only Activity Logs -->
                    <asp:HyperLink
                        ID="lnkActivityLogs"
                        runat="server"
                        Text="Activity Logs"
                        Visible="false" />

                    <asp:HyperLink
                        ID="lnkProfileNav"
                        runat="server"
                        Text="Profile" />

                </nav>
            </div>

            <details class="nav-account">
                <summary aria-label="Open account menu">
                    <span class="nav-avatar">
                        <asp:Image
                            ID="imgNavProfile"
                            runat="server"
                            Visible="false"
                            AlternateText="Profile picture" />

                        <asp:Literal
                            ID="litAvatar"
                            runat="server" />
                    </span>

                    <span class="nav-user">
                        <strong>
                            <asp:Label
                                ID="lblNavName"
                                runat="server" />
                        </strong>

                        <small>
                            <asp:Label
                                ID="lblNavRole"
                                runat="server" />
                        </small>
                    </span>

                    <span>⌄</span>
                </summary>

                <div class="nav-dropdown">
                    <div class="dropdown-caption">
                        <strong>
                            <asp:Label
                                ID="lblDropdownName"
                                runat="server" />
                        </strong>

                        <small>
                            <asp:Label
                                ID="lblDropdownRole"
                                runat="server" />
                        </small>
                    </div>

                    <asp:HyperLink
                        ID="lnkProfileDropdown"
                        runat="server"
                        CssClass="dropdown-link"
                        Text="My Profile" />

                    <asp:Button
                        ID="btnMasterLogout"
                        runat="server"
                        Text="Logout"
                        CssClass="logout-button"
                        CausesValidation="false"
                        OnClick="btnMasterLogout_Click" />
                </div>
            </details>
        </header>

        <main class="main">
            <div class="main-content">
                <asp:ContentPlaceHolder
                    ID="MainContent"
                    runat="server" />
            </div>
        </main>
    </form>
</body>
</html>
